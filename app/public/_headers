/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://trendlens-api.chartlens101.workers.dev; font-src 'self'

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/guide.html
  Cache-Control: no-cache

/guide
  Cache-Control: no-cache

/guide-assets/guide.js
  Cache-Control: no-cache

# Content-hashed filenames never change contents, so they can be cached hard.
# firebase.json already grants this; without it Cloudflare Pages revalidates
# every asset on every load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
